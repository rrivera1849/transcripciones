# Copy to .env on the host. Never commit .env.
SECRET_KEY=change-me-run-openssl-rand-hex-32
TRANSCRIBER=modal              # modal | local (CPU dev, no speaker labels)
MODAL_TOKEN_ID=ak-...
MODAL_TOKEN_SECRET=as-...
RETENTION_DAYS=30              # audio deleted this many days after transcription (0 = immediately, -1 = never)
MAX_UPLOAD_MB=4096
TUNNEL_TOKEN=eyJ...            # Cloudflare Tunnel token (production only; leave blank for local dev)

# Public address, used in "your transcript is ready" emails.
APP_URL=https://latranscriptora.com
# Outgoing mail. Leave SMTP_HOST empty to disable notifications.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com SMTP_PASSWORD=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
